          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Button"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        },
        "variant": {
          "enum": [
            "default",
            "primary"
          ]
        },
        "action": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "context": {
