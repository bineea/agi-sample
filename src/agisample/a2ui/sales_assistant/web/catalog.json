                            "type": "string"
                          }
                        },
                        "required": [
                          "path"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "label",
            "event"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "component",
        "rows",
        "columns",
        "caption",
        "emptyText"
      ],
      "additionalProperties": false
