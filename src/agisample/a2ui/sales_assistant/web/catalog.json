                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "component",
        "child",
        "action"
      ],
      "additionalProperties": false
    },
    "DataTable": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "DataTable"
        },
        "caption": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "rows": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "align": {
                "enum": [
                  "left",
                  "right"
                ]
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "emptyText": {
          "type": "string"
        },
        "rowAction": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
