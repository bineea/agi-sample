    "Row": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Row"
        },
        "children": {
          "allOf": [
            {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList"
            },
            {
              "type": "array",
              "items": {
                "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
        }
      },
      "required": [
        "id",
        "component",
        "child"
      ],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
